
from collections import deque

def is_valid(state):
    m_left, c_left, boat = state
    m_right = 3 - m_left
    c_right = 3 - c_left

    # Check the number of people on both river banks
    if not (0 <= m_left <= 3 and 0 <= c_left <= 3):
        return False

    if m_left > 0 and m_left < c_left:
        return False

    if m_right > 0 and m_right < c_right:
        return False

    return True


def get_next_states(state):
    m_left, c_left, boat = state
    moves = [(1, 0), (2, 0), (0, 1),
             (0, 2), (1, 1)]

    next_states = []

    for m, c in moves:
        if boat == 0:  # Boat is on the left bank
            new_state = (m_left - m, c_left - c, 1)
        else:          # Boat is on the right bank
            new_state = (m_left + m, c_left + c, 0)

        if is_valid(new_state):
            # Ensure passengers are available on the boat's bank
            if boat == 0:
                available = m_left >= m and c_left >= c
            else:
                available = (3 - m_left >= m and
                             3 - c_left >= c)

            if available:
                next_states.append(new_state)

    return next_states


def solve():
    start = (3, 3, 0)
    goal = (0, 0, 1)

    queue = deque([(start, [start])])
    visited = {start}

    while queue:
        state, path = queue.popleft()

        if state == goal:
            print("Solution Found!\n")

            for step, s in enumerate(path):
                m_left, c_left, boat = s
                m_right = 3 - m_left
                c_right = 3 - c_left

                boat_position = "Left" if boat == 0 else "Right"

                print(f"Step {step}:")
                print(f"Left Bank  : M={m_left}, C={c_left}")
                print(f"Right Bank : M={m_right}, C={c_right}")
                print(f"Boat       : {boat_position}\n")

            return

        for next_state in get_next_states(state):
            if next_state not in visited:
                visited.add(next_state)
                queue.append((next_state, path + [next_state]))

    print("No solution found.")


solve()
